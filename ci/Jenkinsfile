import java.text.SimpleDateFormat
import java.util.Date
pipeline {
   agent any
       parameters {
                   text defaultValue: '@Integracion', description: 'TIPO DE PRUEBA FUNCIONAL A EJECUTAR', name: 'TIPO_PRUEBA'
       }



    environment {
        SCM_URL = "https://github.com/JavierCamargoTovio/API_USERS_TEST_SCREMPLAY.git"
        SCM_BRANCH = "main"
        NOMBRE_PROYECTO = "Test Project Automation Users"
        NOMBRE_TRANSACCION = "Test Project Automation Users"
        EMAIL_DEVELOPERS = "javiercamargot22@gmail.com"
    }



    stages {

        stage('Clonar proyecto') {
            steps {
                bat 'git config --global --replace-all http.sslVerify false'
                git url: "${SCM_URL}", branch: "${SCM_BRANCH}"
            }
        }

           stage('Ejecutar pruebas') {
                    steps {
                        script {
                            try{
                               echo "Se ejecuta pruebas: ${TIPO_PRUEBA}"
                               bat "gradlew.bat clean test aggregate --info -DTiporegresion=${TIPO_PRUEBA}";
                               currentBuild.result = 'SUCCESS'
                               }catch(ERRORUNO){
                               echo "Algunos escenarios fallaron"
                               }
                        }
                    }
           }


           stage('Generar evidencia') {
                    steps {
                        script {
                            catchError {
                                   publishHTML([
                                        allowMissing         : false,
                                        alwaysLinkToLastBuild: true,
                                        keepAll              : true,
                                        reportDir            : 'target/site/serenity',
                                        reportFiles          : 'index.html',
                                        reportName           : 'Evidencias Pruebas Aceptacion',
                                        reportTitles         : 'HTML Report Serenity'
                                    ])
                                    echo 'Reporte Html realizado con exito'

                            }
                        }
                    }
           }


           stage('Notificar'){
                   steps{
                     catchError{
                       script{
                         enviarCorreo(currentBuild.result)
                       }
                     }
                   }
           }

   }

 }

def enviarCorreo(resultadoTest) {
